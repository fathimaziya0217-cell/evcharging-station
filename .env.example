# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/ev_charging_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=ev_app
DB_PASSWORD=ev_secure_password_123

# Initial Administrator Account (Created automatically if not present)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@evcharge.com
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=+919876543210

# Payment Gateway Configuration
# Mode options: DEMO (simulated transactions) | REAL (Razorpay / payment provider)
PAYMENT_MODE=DEMO
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Server Port
SERVER_PORT=8080
